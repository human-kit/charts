{
	"name": "@human-kit/charts",
	"version": "0.0.0",
	"description": "Accessible, headless chart components for Svelte 5.",
	"license": "MIT",
	"author": "Agustin Delgado <agustindariodelgado@gmail.com>",
	"homepage": "https://charts.human-kit.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/human-kit/charts.git",
		"directory": "packages/charts"
	},
	"bugs": {
		"url": "https://github.com/human-kit/charts/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"charts",
		"chart",
		"data-visualization",
		"accessible",
		"a11y",
		"headless",
		"svg",
		"human-kit"
	],
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./scales/linear": {
			"types": "./dist/scales/linear.d.ts",
			"default": "./dist/scales/linear.js"
		},
		"./scales/time": {
			"types": "./dist/scales/time.d.ts",
			"default": "./dist/scales/time.js"
		},
		"./scales/band": {
			"types": "./dist/scales/band.d.ts",
			"default": "./dist/scales/band.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*-test.svelte",
		"!dist/**/*-test.svelte.d.ts"
	],
	"scripts": {
		"dev": "vite dev",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:ssr": "vitest run --config vitest.ssr.config.ts"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	}
}
