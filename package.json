{
	"name": "@human-kit/charts-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=20",
		"pnpm": ">=9"
	},
	"scripts": {
		"dev": "pnpm --filter @human-kit/charts dev",
		"dev:docs": "pnpm --filter docs dev",
		"build": "pnpm --filter @human-kit/charts run package",
		"build:docs": "pnpm --filter docs build",
		"docs:api": "node scripts/gen-api.mjs",
		"docs:install": "node scripts/gen-install.mjs",
		"docs:og": "node scripts/gen-og.mjs",
		"test": "pnpm --filter @human-kit/charts test",
		"test:ssr": "pnpm --filter @human-kit/charts test:ssr",
		"typecheck": "pnpm --filter @human-kit/charts check && pnpm --filter docs check",
		"size": "node scripts/size.mjs",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint . && pnpm run ste:check",
		"ste:check": "node scripts/check-ste.mjs",
		"changeset": "changeset",
		"release": "pnpm run build && node scripts/publish.mjs"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^9.38.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/package": "^2.3.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^20",
		"@vitest/browser": "^4.0.16",
		"@vitest/browser-playwright": "^4.0.16",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"jiti": "^2.7.0",
		"playwright": "^1.57.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"publint": "^0.2.0",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.4",
		"ts-morph": "^28.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^7.1.10",
		"vitest": "^4.0.16",
		"vitest-browser-svelte": "^2.0.1"
	}
}
